{
  "name": "asmagicbrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "storybook": "node ui-workshop/.storybook/run.mjs serve",
    "build-storybook": "node ui-workshop/.storybook/run.mjs build",
    "serve-static": "node ui-workshop/.storybook/static-server.mjs",
    "typecheck": "node ui-workshop/.storybook/run.mjs typecheck && npm run native:typecheck",
    "test": "node tools/test.mjs",
    "native:runtime": "node apps/native/prepare-runtime.mjs",
    "native:build": "node apps/native/build.mjs",
    "native:package": "node apps/native/package-dispatch.mjs",
    "native": "node apps/native/launch.mjs",
    "native:test": "node apps/native/test.mjs",
    "native:acceptance": "node apps/native/acceptance/run.mjs",
    "native:acceptance:sidebar": "node apps/native/acceptance/sidebar.mjs --run-isolated",
    "native:typecheck": "node node_modules/typescript/bin/tsc --noEmit --project apps/native/tsconfig.json",
    "native:acceptance:drag-drop": "node apps/native/acceptance/drag-drop.mjs --run-isolated",
    "native:acceptance:v3": "node apps/native/acceptance/navigation-strip.mjs --run-isolated",
    "native:acceptance:navigation": "node apps/native/acceptance/navigation-strip.mjs --run-isolated",
    "native:acceptance:repositories": "node apps/native/acceptance/all-repositories.mjs --run-isolated",
    "native:acceptance:search": "node apps/native/acceptance/search-explorer-outline.mjs --run-isolated",
    "native:acceptance:management": "node apps/native/acceptance/repository-management.mjs --run-isolated",
    "native:git-runtime": "node apps/native/prepare-git.mjs --download",
    "native:package:external": "node apps/native/external-package.mjs",
    "native:deliver:external": "node apps/native/external-delivery.mjs",
    "postinstall": "node tools/bootstrap.mjs",
    "bootstrap": "node tools/bootstrap.mjs",
    "build": "node tools/build.mjs",
    "storybook:seed": "node ui-workshop/.storybook/seed-workspace.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@supabase/auth-js": "2.116.0",
    "@vscode/ripgrep": "1.18.0",
    "dompurify": "3.4.15",
    "fzf": "0.5.2",
    "ignore": "7.0.9",
    "katex": "0.18.7",
    "markdown-it": "15.0.2",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
